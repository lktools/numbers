{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "declaration": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "noEmit": true
  },

  "include": [
    "src",
    "tests",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}